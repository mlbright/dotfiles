#!/usr/bin/env bash
# kube-use - pick which Kubernetes cluster (kubeconfig context) kubectl talks
# to, and make it the default.
#
# The choice is saved as current-context in the kubeconfig (${KUBECONFIG} or
# ~/.kube/config), so it sticks for every new shell and for any tool that
# reads kubeconfig (helm, k9s, ...).
#
# AWS EKS clusters visible to the current AWS identity (AWS_PROFILE etc.) are
# offered too. Picking one that is not in kubeconfig yet imports it with
# `aws eks update-kubeconfig` (after backing up the kubeconfig) and makes it
# the default. EKS lookup is skipped quietly if the aws CLI is missing or not
# logged in.
#
# Usage:
#   kube-use            interactive menu (fzf if installed, numbered list otherwise)
#   kube-use NAME|N     switch straight to context/EKS cluster NAME, or entry N of the list
#   kube-use -l         list choices, marking the current one
#   kube-use -c         print the current context
#   kube-use -A ...     look for EKS clusters in every enabled AWS region
#   kube-use -n ...     skip the AWS EKS lookup
#
# EKS regions searched: $KUBE_USE_AWS_REGIONS (space-separated) if set, else
# $AWS_REGION / $AWS_DEFAULT_REGION / the profile's configured region.
set -euo pipefail

usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p;}' "$0"; }

command -v kubectl >/dev/null || { echo "error: kubectl not found in PATH" >&2; exit 1; }

KUBECONFIG_PATH="${KUBECONFIG:-$HOME/.kube/config}"
KUBECONFIG_PATH="${KUBECONFIG_PATH%%:*}"   # aws writes to the first file

use_aws=1
all_regions=0
action=menu
target=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -l|--list) action=list ;;
    -c|--current) action=current ;;
    -A|--all-regions) all_regions=1 ;;
    -n|--no-aws) use_aws=0 ;;
    -*) echo "error: unknown option $1" >&2; usage >&2; exit 2 ;;
    *) action=switch; target=$1 ;;
  esac
  shift
done

current=$(kubectl config current-context 2>/dev/null || true)

if [[ $action == current ]]; then
  [[ -n "$current" ]] && echo "$current" || { echo "(none)" >&2; exit 1; }
  exit 0
fi

# Choices: parallel arrays. kind is "ctx" (existing kubeconfig context) or
# "eks" (EKS cluster not yet in kubeconfig; ref is "region name").
names=(); kinds=(); refs=(); notes=()

while IFS= read -r ctx; do
  [[ -n "$ctx" ]] || continue
  names+=("$ctx"); kinds+=(ctx); refs+=("$ctx"); notes+=("")
done < <(kubectl config get-contexts -o name 2>/dev/null)

has_name() {
  local n
  for n in ${names[@]+"${names[@]}"}; do [[ "$n" == "$1" ]] && return 0; done
  return 1
}

aws_regions() {
  if (( all_regions )); then
    aws ec2 describe-regions --query 'Regions[].RegionName' --output text 2>/dev/null | tr '\t' ' '
  elif [[ -n "${KUBE_USE_AWS_REGIONS:-}" ]]; then
    echo "$KUBE_USE_AWS_REGIONS"
  else
    echo "${AWS_REGION:-${AWS_DEFAULT_REGION:-$(aws configure get region 2>/dev/null || true)}}"
  fi
}

if (( use_aws )) && command -v aws >/dev/null; then
  regions=$(aws_regions)
  if [[ -n "${regions// /}" ]]; then
    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT
    [[ -t 2 ]] && printf 'Looking up EKS clusters in %s...\r' "$regions" >&2
    for r in $regions; do
      aws eks list-clusters --region "$r" --query 'clusters[]' --output text \
        >"$tmpdir/$r" 2>/dev/null &
    done
    wait || true
    [[ -t 2 ]] && printf '\033[2K' >&2

    # `aws eks update-kubeconfig` names the kubeconfig cluster entry by ARN.
    account=$(aws sts get-caller-identity --query Account --output text 2>/dev/null || true)
    known_clusters=$'\n'$(kubectl config get-clusters 2>/dev/null | tail -n +2)$'\n'
    for r in $regions; do
      [[ -s "$tmpdir/$r" ]] || continue
      for c in $(tr '\t' ' ' <"$tmpdir/$r"); do
        [[ "$c" == None ]] && continue
        [[ "$known_clusters" == *$'\n'"arn:aws:eks:$r:$account:cluster/$c"$'\n'* ]] && continue
        alias=$c
        has_name "$alias" && alias="$c@$r"
        names+=("$alias"); kinds+=(eks); refs+=("$r $c"); notes+=("EKS $r, not in kubeconfig yet")
      done
    done
  fi
fi

if [[ ${#names[@]} -eq 0 ]]; then
  echo "error: no contexts in $KUBECONFIG_PATH and no EKS clusters found" >&2
  exit 1
fi

label() {
  local i=$1
  if [[ -n "${notes[$i]}" ]]; then
    printf '%s  (%s)' "${names[$i]}" "${notes[$i]}"
  else
    printf '%s' "${names[$i]}"
  fi
}

list() {
  local i mark
  for i in "${!names[@]}"; do
    mark=" "
    [[ ${kinds[$i]} == ctx && "${names[$i]}" == "$current" ]] && mark="*"
    printf '  %s %2d) %s\n' "$mark" $((i + 1)) "$(label "$i")"
  done
}

# Resolve a name or 1-based list index; prints the choice index.
resolve() {
  local arg=$1 i
  if [[ "$arg" =~ ^[0-9]+$ ]] && (( arg >= 1 && arg <= ${#names[@]} )); then
    echo $((arg - 1)); return
  fi
  for i in "${!names[@]}"; do
    [[ "${names[$i]}" == "$arg" ]] && { echo "$i"; return; }
  done
  # An EKS cluster can also be named without its @region suffix.
  for i in "${!names[@]}"; do
    [[ ${kinds[$i]} == eks && "${refs[$i]#* }" == "$arg" ]] && { echo "$i"; return; }
  done
  return 1
}

import_eks() {
  local region=$1 cluster=$2 alias=$3 backup profile_args=()
  if [[ -f "$KUBECONFIG_PATH" ]]; then
    backup="$KUBECONFIG_PATH.bak-$(date +%Y%m%d-%H%M%S)"
    cp -p "$KUBECONFIG_PATH" "$backup"
    echo "Backed up kubeconfig to $backup"
  fi
  # Pin the profile into the kubeconfig so the token works without AWS_PROFILE set.
  [[ -n "${AWS_PROFILE:-}" ]] && profile_args=(--profile "$AWS_PROFILE")
  aws eks update-kubeconfig --region "$region" --name "$cluster" --alias "$alias" \
    --kubeconfig "$KUBECONFIG_PATH" ${profile_args[@]+"${profile_args[@]}"} >/dev/null
  echo "Imported EKS cluster '$cluster' ($region) as context '$alias'."
}

switch() {
  local i=$1 ctx=${names[$1]}
  if [[ ${kinds[$i]} == eks ]]; then
    import_eks "${refs[$i]%% *}" "${refs[$i]#* }" "$ctx"
  elif [[ "$ctx" == "$current" ]]; then
    echo "Already using '$ctx'."
  else
    kubectl config use-context "$ctx" >/dev/null
  fi
  [[ "$ctx" != "$current" ]] && echo "Default cluster is now '$ctx'."
  kubectl config get-contexts "$ctx" | tail -n +2 | awk '{ sub(/^\*/, ""); printf "  cluster: %s  user: %s  namespace: %s\n", $2, $3, ($4 == "" ? "default" : $4) }'
}

case $action in
  list) list; exit 0 ;;
  switch)
    i=$(resolve "$target") || { echo "error: no such context or EKS cluster '$target'" >&2; list >&2; exit 1; }
    switch "$i"
    exit 0
    ;;
esac

# Interactive selection.
if command -v fzf >/dev/null && [[ -t 0 && -t 1 ]]; then
  pick=$(for i in "${!names[@]}"; do printf '%d\t%s\n' $((i + 1)) "$(label "$i")"; done |
    fzf --prompt="kube context> " --height=40% --reverse --delimiter='\t' --with-nth=2 \
        --header="current: ${current:-(none)}") || exit 130
  switch $(( ${pick%%$'\t'*} - 1 ))
  exit 0
fi

if [[ ! -t 0 ]]; then
  echo "error: interactive mode needs a terminal; pass a context name or number" >&2
  exit 1
fi

echo "Kubernetes clusters (* = current default):"
list
while true; do
  read -r -p "Select [1-${#names[@]}, name, q to quit]: " choice || exit 130
  [[ -z "$choice" ]] && continue
  [[ "$choice" == q || "$choice" == Q ]] && exit 0
  if i=$(resolve "$choice"); then
    switch "$i"
    exit 0
  fi
  echo "  invalid choice '$choice'" >&2
done
