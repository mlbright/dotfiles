#!/usr/bin/env bash
# kube-sangria-dev - (re)configure the local kubectl context for the sangria-dev
# RKE2 cluster (nodes sangria-dev-1 / sangria-dev-2 in ~/.ssh/config).
#
# Fetches /etc/rancher/rke2/rke2.yaml from the RKE2 server node over SSH,
# points it at the node's real address instead of 127.0.0.1, renames the
# cluster/context/user from RKE2's "default" to "sangria-dev" (the canonical
# name sites/sangria-dev/topology.yaml requires), verifies it can list nodes,
# then merges it into ~/.kube/config and makes it the current context.
#
# Run this whenever the cluster is reinstalled: RKE2 mints a new CA and the
# old context fails with "certificate signed by unknown authority".
#
# SSH to these hosts is password-only, so run it from an interactive
# terminal. Expect one ssh password prompt per host tried, plus a sudo
# prompt if cpacket lacks NOPASSWD.
set -euo pipefail

CONTEXT="sangria-dev"
# Server (head) node first; the agent is tried only if the head has no rke2.yaml.
HOSTS=("${SANGRIA_HEAD:-sangria-dev-1}" sangria-dev-2)
REMOTE_KUBECONFIG="/etc/rancher/rke2/rke2.yaml"
KUBE_DIR="${HOME}/.kube"
KUBECONFIG_PATH="${KUBECONFIG:-${KUBE_DIR}/config}"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

for cmd in ssh kubectl; do
  command -v "$cmd" >/dev/null || { echo "error: $cmd not found in PATH" >&2; exit 1; }
done
if [[ ! -t 0 || ! -t 1 ]]; then
  echo "error: needs an interactive terminal (ssh to sangria-dev-* is password-only)" >&2
  exit 1
fi

# One multiplexed ssh connection per host: the first (interactive, with a
# tty) command takes the password and sudo prompts on the real terminal; the
# second reuses the connection to stream the file back with clean stdout.
SSH_OPTS=(-o ClearAllForwardings=yes -o ControlMaster=auto
          -o ControlPath="${tmpdir}/cm-%h" -o ControlPersist=60)

# fetch HOST OUTFILE -> copies the remote kubeconfig into OUTFILE. Returns
# non-zero if ssh fails or the file is absent on that host.
fetch() {
  local host=$1 out=$2 remote_tmp
  remote_tmp="/tmp/rke2-kubeconfig-$(whoami)-$$.yaml"
  ssh -t "${SSH_OPTS[@]}" "$host" \
    "sudo install -m 600 -o \"\$(id -un)\" ${REMOTE_KUBECONFIG} ${remote_tmp}" || return 1
  ssh "${SSH_OPTS[@]}" "$host" "cat ${remote_tmp}; rm -f ${remote_tmp}" >"$out" || return 1
  ssh -O exit "${SSH_OPTS[@]}" "$host" 2>/dev/null || true
  grep -q '^kind: Config' "$out"
}

raw="${tmpdir}/rke2.yaml"
head_host=""
for host in "${HOSTS[@]}"; do
  echo "fetching ${REMOTE_KUBECONFIG} from ${host} ..." >&2
  if fetch "$host" "$raw"; then
    head_host=$host
    break
  fi
  echo "  ${host}: could not fetch a kubeconfig (not the RKE2 server, or ssh/sudo failed)" >&2
done
[[ -n "$head_host" ]] || { echo "error: could not fetch a kubeconfig from any of: ${HOSTS[*]}" >&2; exit 1; }

# The apiserver address is the head node's address from ~/.ssh/config.
head_addr=$(ssh -G "$head_host" | awk '/^hostname /{print $2}')
[[ -n "$head_addr" ]] || { echo "error: cannot resolve HostName for ${head_host} from ssh config" >&2; exit 1; }

renamed="${tmpdir}/${CONTEXT}.yaml"
sed -E \
  -e "s#^([[:space:]]*server:) https://127\.0\.0\.1:6443\$#\1 https://${head_addr}:6443#" \
  -e "s/^([[:space:]]*-? ?(name|cluster|user|current-context)): default\$/\1: ${CONTEXT}/" \
  "$raw" >"$renamed"

if ! grep -q "server: https://${head_addr}:6443" "$renamed"; then
  echo "error: fetched kubeconfig did not have the expected 127.0.0.1:6443 server entry:" >&2
  grep 'server:' "$renamed" >&2 || true
  exit 1
fi

echo "verifying access to https://${head_addr}:6443 as context ${CONTEXT} ..." >&2
if ! KUBECONFIG="$renamed" kubectl --context "$CONTEXT" get nodes --request-timeout=15s >&2; then
  echo "error: new kubeconfig cannot reach the cluster; ${KUBECONFIG_PATH} left untouched" >&2
  exit 1
fi

# Merge: the freshly fetched file comes first so its sangria-dev entries win
# over any stale ones; every other context in the existing config is kept.
mkdir -p "$KUBE_DIR"
merged="${tmpdir}/merged"
if [[ -f "$KUBECONFIG_PATH" ]]; then
  backup="${KUBECONFIG_PATH}.bak-$(date +%Y%m%d-%H%M%S)"
  cp -p "$KUBECONFIG_PATH" "$backup"
  echo "backed up ${KUBECONFIG_PATH} -> ${backup}" >&2
  KUBECONFIG="${renamed}:${KUBECONFIG_PATH}" kubectl config view --flatten --raw >"$merged"
else
  cp "$renamed" "$merged"
fi
KUBECONFIG="$merged" kubectl config use-context "$CONTEXT" >/dev/null

install -m 600 "$merged" "$KUBECONFIG_PATH"
echo "wrote ${KUBECONFIG_PATH}; current context is now '${CONTEXT}' (server ${head_host} = ${head_addr})" >&2
